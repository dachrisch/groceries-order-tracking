# MongoDB Connection URI (REQUIRED in production)
MONGODB_URI=mongodb://localhost:27017/groceries_tracking

# JWT Secret for Authentication (REQUIRED in production)
JWT_SECRET=your-random-secret-key-change-me-for-security-reasons-1234567890

# CSRF Secret for Double Submit Cookie (REQUIRED in production)
CSRF_SECRET=your-random-csrf-secret-key-change-me-for-security-reasons-0987654321

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# opencode (optional) — enables natural-language intent parsing and occasion
# naming. Simple commands ("fill my inventory for this week", "pizza for 6")
# still work without it.
OPENCODE_BASE_URL=https://code.lehel.xyz
OPENCODE_API_KEY=
# Only for servyy-test.lxd, whose internal opencode hostname has a self-signed cert.
OPENCODE_ALLOW_INSECURE_TLS=false
# Optional "provider:id,..." override. Leave empty: the client discovers the
# active free models from GET /api/model and never tries a deprecated one.
OPENCODE_MODELS=
# Photo intake only. FREE vision models are tried first; only when every one of them
# failed does the curated paid tier answer, with one attempt per model. That is a bound
# per attempt, not a price ceiling for a photo: while the free vision models are
# unavailable (provider errors, not a quota 429), every upload re-buys the whole tier.
# "off|false|0|no" drops the curated tier; a paid model pinned in OPENCODE_VISION_MODELS
# is still used, so remove the pin to stop it.
OPENCODE_VISION_PAID=on
# Optional "provider:id,..." chain for photo intake alone, overriding discovery. It
# replaces the discovered free chain (curated paid models still follow it while the paid
# tier is on), and never affects text calls, so a pinned text model cannot hijack a photo.
OPENCODE_VISION_MODELS=
