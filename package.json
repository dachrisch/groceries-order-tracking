{
  "name": "groceries-order-tracking",
  "version": "1.9.38",
  "description": "Track grocery orders and price trends from Knuspr",
  "main": "src/api/server.ts",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx watch src/api/server.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/api/server.ts --bundle --platform=node --outfile=dist-server/server.js --format=esm --packages=external",
    "start:prod": "node dist-server/server.js",
    "serve": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "lint": "eslint .",
    "db:dump": "tsx scripts/db-dump.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dachrisch/groceries-order-tracking.git"
  },
  "license": "ISC",
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-solid": "^1.8.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.5.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^10.0.0",
    "daisyui": "^5.5.19",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  }
}
